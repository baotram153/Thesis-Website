---
import type { Author } from "../types/types";

interface Props {
  authors: Author[];
}

const { authors } = Astro.props;
---

<div class="grid w-full grid-cols-1 gap-x-12 gap-y-6 sm:grid-cols-2">
  {
    authors.map((author) => (
      <div class="flex flex-col items-center text-center leading-snug">
        <div class="text-lg font-semibold">
          {author.role && <span class="mr-1">{author.role}:</span>}
          {author.url ? <a href={author.url}>{author.name}</a> : author.name}
          {author.notes && (
            <sup>
              {author.notes.map(
                (note, index, array) =>
                  note + (index < array.length - 1 ? "," : ""),
              )}
            </sup>
          )}
        </div>
        {author.institution && <div class="italic">{author.institution}</div>}
        {author.affiliation?.map((line) => (
          <div class="italic">{line}</div>
        ))}
        {author.location && <div>{author.location}</div>}
        {author.orcid && (
          <div>
            ORCID:{" "}
            <a class="italic" href={`https://orcid.org/${author.orcid}`}>
              {author.orcid}
            </a>
          </div>
        )}
      </div>
    ))
  }
</div>
